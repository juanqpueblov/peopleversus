<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{{ title }} | People Versus</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css" />
  <link rel="stylesheet" href="{{ '/style.css' | url }}" />
  <link rel="icon" href="{{ '/favicon.ico' | url }}" />
</head>
<body>
  <main class="container">
    <header class="header">
      <h1><a href="{{ '/' | url }}">People Versus</a></h1>
      <nav>
        <a href="{{ '/' | url }}">Home</a>
        <a href="{{ '/about/' | url }}">About</a>
        <a href="{{ '/tags/' | url }}">Topics</a>
        <a href="https://peopleversus.substack.com/subscribe" target="_blank" rel="noopener"><strong>Support</strong></a>
      </nav>
      <hr/>
    </header>

    <article>
      {{ content | safe }}
    </article>

    <footer>
      <hr/>
      <small>© {% year %} People Versus • <a href="https://peopleversus.substack.com" target="_blank" rel="noopener">Newsletter</a></small>
    </footer>
  </main>
</body>
</html>
